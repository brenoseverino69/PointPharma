{
  "expo": {
    "name": "PointPharma",
    "slug": "pointpharma",
    "scheme": "pointpharma",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "splash": {
